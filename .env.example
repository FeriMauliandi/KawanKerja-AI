# LLM Generator via Groq
GROQ_API_KEY=your_groq_api_key_here
# Model default proyek; ganti ke model Groq lain bila perlu.
LLM_MODEL=openai/gpt-oss-20b

# Embedding via Google AI Studio (Gemini Embedding)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Reranker neural via OpenRouter (opsional; default retrieval tidak memakai
# reranker karena pada ~101 chunk ia menambah latensi tanpa kenaikan MRR).
# Model default: cohere/rerank-v3.5. Butuh saldo/akses ke model tersebut.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# RERANKER_MODEL=cohere/rerank-v3.5

# Strategi retrieval (opsional, nilai default sudah cocok untuk korpus kecil)
RETRIEVAL_FETCH_K=25
RETRIEVAL_RERANK_CANDIDATES=20
RETRIEVAL_FINAL_K=5
RETRIEVAL_ENABLE_RERANKER=false
RETRIEVAL_ENABLE_QUERY_EXPANSION=false

# (Opsional) Batasi origin frontend, mis. https://kawankerja.example.com
# Default "*" (terbuka); credentials otomatis nonaktif saat origin "*".
# CORS_ALLOW_ORIGINS=https://kawankerja.example.com

# (Opsional) Observability dengan LangSmith
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=kawankerjaAI
